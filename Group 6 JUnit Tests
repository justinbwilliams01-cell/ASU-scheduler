import org.junit.Test;
import static org.junit.Assert.*;
   
public class StudentRecordsTest {

    @Test
    public void testStudentsAndTranscriptsLoaded() throws Exception {
        // use Group 2 code
        
        StudentRecords records = new StudentRecords();
        Object[] allData = records.getAllRecords();
        String[][] students = (String[][]) allData[0];
        String[][] transcripts = (String[][]) allData[1];
     



        assertNotNull("students array should not be null", students);
        assertTrue("should load at least one student record", students.length > 0);

        assertNotNull("transcripts array should not be null", transcripts);
        assertTrue("should load at least one transcript record", transcripts.length > 0);
    }
}



